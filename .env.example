# Скопируй в .env и заполни: cp .env.example .env

# --- Окружение ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL (используется и docker compose, и приложением) ---
POSTGRES_USER=getfirstoffer
POSTGRES_PASSWORD=getfirstoffer
POSTGRES_DB=getfirstoffer
# Порт на хосте (5432 часто занят локальным PostgreSQL)
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://getfirstoffer:getfirstoffer@localhost:5433/getfirstoffer

# --- Redis ---
# Порт на хосте (6379 часто занят локальным Redis)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- hh.ru ---
# Обязательный заголовок для api.hh.ru: "<название>/<версия> (<email>)"
HH_USER_AGENT=getFirstOffer/0.1 (you@example.com)
# Данные приложения с dev.hh.ru. По ним один раз получаем токен:
#   cd backend && .venv/bin/python -m app.sources.hh_token
HH_CLIENT_ID=
HH_CLIENT_SECRET=
# Токен приложения (бессрочный), сюда вставляем результат команды выше
HH_APP_TOKEN=
# Включить парсинг сайта hh.ru в дополнение к API
PARSER_ENABLED=false
# Источник вакансий: auto — API, а если он отвечает 403, сайт hh.ru (RSS-лента + страница поиска);
# api — только API; rss — только сайт
HH_SOURCE=auto
# Площадки через запятую: hh, habr, superjob, getmatch, trudvsem (подключаются по мере готовности)
PORTALS=hh

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# chat_id для алертов о проблемах сервиса (воркер упал, hh.ru отвечает ошибками)
ADMIN_CHAT_ID=

# --- Email (вход на сайт) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Auth ---
JWT_SECRET=change-me
