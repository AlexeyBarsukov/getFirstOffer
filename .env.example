# Скопируй в .env и заполни: cp .env.example .env

# --- Окружение ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL (используется и docker compose, и приложением) ---
POSTGRES_USER=getfirstoffer
POSTGRES_PASSWORD=getfirstoffer
POSTGRES_DB=getfirstoffer
# Порт на хосте (5432 часто занят локальным PostgreSQL)
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://getfirstoffer:getfirstoffer@localhost:5433/getfirstoffer

# --- Redis ---
# Порт на хосте (6379 часто занят локальным Redis)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- hh.ru ---
# Обязательный заголовок для api.hh.ru: "<название>/<версия> (<email>)"
HH_USER_AGENT=getFirstOffer/0.1 (you@example.com)
# Токен приложения с dev.hh.ru (необязательно на старте)
HH_APP_TOKEN=
# Включить парсинг сайта hh.ru в дополнение к API
PARSER_ENABLED=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Email (вход на сайт) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Auth ---
JWT_SECRET=change-me
